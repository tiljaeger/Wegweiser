{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wegweiser",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "build": { "command": "npm run build", "watch_dir": "src" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
