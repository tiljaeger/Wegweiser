{
  "name": "wegweiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "eslint . --max-warnings 0",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.22",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
